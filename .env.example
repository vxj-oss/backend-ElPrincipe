# Aplicación
APP_NAME="El Príncipe - Agente de Ventas"
APP_VERSION="1.0.0"
DEBUG=True
ENVIRONMENT=development
DATABASE_URL=postgresql://usuario:tu_password@localhost:5432/nombre_bd

# Seguridad JWT
SECRET_KEY=cambia_esto_por_un_secreto_seguro_de_64_caracteres_minimo
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Proveedor del Agente IA: actualmente solo se usa "groq" (nube, requiere API key)
LLM_PROVIDER=groq

# Ollama / LLaMA (local) — deshabilitado, solo se usa Groq por ahora.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# Groq (nube) — obtén tu key en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

FRONTEND_URL=http://localhost:5173

# Superusuario inicial (creado por el script de seed)
FIRST_SUPERUSER=cambia_este_usuario
FIRST_SUPERUSER_PASSWORD=cambia_esta_clave

# Usuario asesor de ejemplo (creado por el script de seed)
SEED_ASESOR_USERNAME=cambia_este_usuario
SEED_ASESOR_PASSWORD=cambia_esta_clave
